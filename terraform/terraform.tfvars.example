# Copy this to terraform.tfvars and fill in real values, OR pass these as
# TF_VAR_db_password / TF_VAR_admin_password environment variables instead.
# terraform.tfvars is in .gitignore for a reason — never commit real secrets.

db_password    = "choose-a-strong-password"
admin_password = "choose-a-different-strong-password"

# Optional overrides:
# aws_region       = "us-east-1"
# instance_type    = "t3.micro"

# Turn on claimant emails through Amazon SES. AWS sends this address a link to click
# before it can send. Leave it out to keep emails off.
# notification_from_email = "you@example.com"
